<?xml version="1.0" encoding="utf-8"?>
<robot name="URDF_RobotDiploma">

  <link name="custom_base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="custom_base_footprint"/>
    <child link="custom_base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/> 
  </joint>

  <link name="custom_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://URDF_RobotDiploma/meshes/base_link.STL" />
      </geometry>
      <material name=""><color rgba="0.79 0.82 0.93 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.4 0.44 0.2"/> 
      </geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry><mesh filename="package://URDF_RobotDiploma/meshes/left_wheel.STL" /></geometry>
      <material name=""><color rgba="0.79 0.82 0.93 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.067" length="0.04"/></geometry>
    </collision>
  </link>

  <joint name="leftwheel" type="continuous">
    <origin xyz="0.00033999 0.194 0.013" rpy="1.5708 0 0" />
    <parent link="custom_base_link" />
    <child link="left_wheel" />
    <axis xyz="0 0 -1" />
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry><mesh filename="package://URDF_RobotDiploma/meshes/right_wheel.STL" /></geometry>
      <material name=""><color rgba="0.79 0.82 0.93 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.067" length="0.04"/></geometry>
    </collision>
  </link>

  <joint name="rightwheel" type="continuous">
    <origin xyz="0.00045567 -0.194 0.013" rpy="1.5708 0 0" />
    <parent link="custom_base_link" />
    <child link="right_wheel" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="front_caster">
    <visual>
      <geometry><mesh filename="package://URDF_RobotDiploma/meshes/front_caster.STL" /></geometry>
    </visual>
  </link>
  <joint name="frontcasterjoint" type="fixed">
    <origin xyz="0.1283 0 -0.0243" rpy="0 0 0" />
    <parent link="custom_base_link" />
    <child link="front_caster" />
  </joint>

  <link name="back_caster">
    <visual>
      <geometry><mesh filename="package://URDF_RobotDiploma/meshes/back_caster.STL" /></geometry>
    </visual>
  </link>
  <joint name="backcasterjoint" type="fixed">
    <origin xyz="-0.1267 0 -0.0243" rpy="0 0 0" />
    <parent link="custom_base_link" />
    <child link="back_caster" />
  </joint>

  <link name="lidar_front_right">
    <visual><geometry><mesh filename="package://URDF_RobotDiploma/meshes/lidar_front_right.STL" /></geometry></visual>
  </link>
  <joint name="lidar1" type="fixed">
    <origin xyz="0.1438 -0.1185 0.0232" rpy="0 3.14159 0" />
    <parent link="custom_base_link" />
    <child link="lidar_front_right" />
  </joint>

  <link name="lidar_front_left">
    <visual><geometry><mesh filename="package://URDF_RobotDiploma/meshes/lidar_front_left.STL" /></geometry></visual>
  </link>
  <joint name="lidar2" type="fixed">
    <origin xyz="0.1439 0.1185 0.0232" rpy="0 3.14159 0" />
    <parent link="custom_base_link" />
    <child link="lidar_front_left" />
  </joint>

  <link name="lidar_back_left">
    <visual><geometry><mesh filename="package://URDF_RobotDiploma/meshes/lidar_back_left.STL" /></geometry></visual>
  </link>
  <joint name="lidar3" type="fixed">
    <origin xyz="-0.1431 0.1185 0.0232" rpy="0 0 0" />
    <parent link="custom_base_link" />
    <child link="lidar_back_left" />
  </joint>

  <link name="lidar_back_right">
    <visual><geometry><mesh filename="package://URDF_RobotDiploma/meshes/lidar_back_right.STL" /></geometry></visual>
  </link>
  <joint name="lidar4" type="fixed">
    <origin xyz="-0.1431 -0.1185 0.0232" rpy="0 0 0" />
    <parent link="custom_base_link" />
    <child link="lidar_back_right" />
  </joint>

  <link name="top_link">
    <visual><geometry><mesh filename="package://URDF_RobotDiploma/meshes/top_link.STL" /></geometry></visual>
  </link>
  <joint name="toplinkjoint" type="fixed">
    <origin xyz="0.1179 0 0.065" rpy="0 0 0" />
    <parent link="custom_base_link" />
    <child link="top_link" />
  </joint>

  <link name="camera_link">
    <visual><geometry><mesh filename="package://URDF_RobotDiploma/meshes/camera_link.STL" /></geometry></visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.0324 -0.002 0.36" rpy="1.5708 0 1.5708" />
    <parent link="top_link" />
    <child link="camera_link" />
  </joint>

</robot>